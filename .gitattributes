# Normalizar fin de línea en el repo
* text=auto

# Python y texto: LF
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
*.csv   text eol=lf
*.json  text eol=lf

# Binarios: sin normalización
*.jpg   binary
*.JPG   binary
*.jpeg  binary
*.png   binary
*.tif   binary
*.tiff  binary
*.pt    binary
*.ckpt  binary
*.pth   binary
*.pdf   binary
